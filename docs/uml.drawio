<mxfile host="app.diagrams.net">
  <diagram name="Use Case - HMS" id="hms-uc">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="Hospital Management System" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="360" height="360" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="actorAdmin" value="Admin / Receptionist" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="actorDoctor" value="Doctor" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="700" y="220" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Use cases -->
        <mxCell id="uc1" value="Register Patient" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc2" value="Edit / Delete Patient Record" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="190" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc3" value="Search Patient" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="270" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc4" value="Book / Cancel Appointment" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="350" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc5" value="View Doctor Availability" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc6" value="View Appointment History" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Admin connections -->
        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorAdmin" target="uc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorAdmin" target="uc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorAdmin" target="uc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorAdmin" target="uc4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Doctor connections -->
        <mxCell id="e5" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorDoctor" target="uc5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=none;html=1;endArrow=none;" edge="1" parent="1" source="actorDoctor" target="uc6"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
